# Copy to .env and adjust: cp .env.example .env
# .env is git-ignored. Never commit real secrets (R9.1, R10.4).
# Every variable maps to a field in runtime/config.py, except the first section
# (read by Compose and ./setup.sh).

LOG_LEVEL=INFO

# --- The stack in containers (./setup.sh) -------------------------------------
# The UI, and the API behind it at /api (http://localhost:3000). Setup picks a free
# port if 3000 is taken.
UI_PORT=3000
API_REPLICAS=2

# --- Postgres ---------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=agent_runtime
POSTGRES_USER=agent
# Local development only. In Kubernetes this comes from a Secret.
# This is the *migrator* (schema owner): used only by `runtime db …` commands.
POSTGRES_PASSWORD=change-me-local-only

# Least-privilege login user per component (R14.13), created by
# `runtime db provision-users` (run by `make up`). The API and workers refuse
# to start without theirs.
API_POSTGRES_USER=agent_api
API_POSTGRES_PASSWORD=change-me-api-local-only
WORKER_POSTGRES_USER=agent_worker
WORKER_POSTGRES_PASSWORD=change-me-worker-local-only

# --- Redis ------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# --- Workers (R2.2, R10.7) ----------------------------------------------------
WORKER_CONCURRENCY=4
WORKER_GRACE_S=50
RELAY_INTERVAL_S=10
RELAY_STALE_S=30

# --- Run limits (R1.7, R2.8, R2.9) -------------------------------------------
RUN_TIMEOUT_S=1200
RUN_MAX_STEPS=200
RUN_MAX_CHILDREN=6
RUN_MAX_DEPTH=2
RUN_MAX_DESCENDANTS=20
QUEUE_DEPTH_LIMIT=100
OVERLOAD_RETRY_AFTER_S=5

# --- Server ceilings (R14.3): agents and per-run options can only go lower ---
CEILING_MODEL_CALLS=100
CEILING_TOOL_CALLS=100
CEILING_TOKENS=1000000
CEILING_COST_USD=2.0
# At this share of any budget the agent gets one wrap-up turn (R14.2)
SOFT_LIMIT_RATIO=0.8

# --- Model connections (Settings → Models): the master key ------------------
# Encrypts the model keys you save in Nuria. Generated by ./setup.sh; keep .env safe:
# without this value, saved keys can't be opened (re-enter them in Settings → Models).
NURIA_SECRET_KEY=change-me

# Web search (L6a): SearXNG, in the stack. Its own secret (generated by setup).
SEARXNG_SECRET=change-me

# Code and shell (L6b): the token workers use to ask sandboxd for a sandbox (generated by setup).
SANDBOXD_TOKEN=change-me

# --- Models (R3.1): scripted (keyless, default) | openai | ollama --------------
MODEL_PROVIDER=scripted
# OPENAI_API_KEY=sk-...        # only for MODEL_PROVIDER=openai; never commit it
OPENAI_BASE_URL=https://api.openai.com/v1
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# `make llm-up` pulls qwen2.5:7b; another one: make llm-up OLLAMA_MODEL=llama3.1:8b
# (then set MODEL_CHAT to the same name).
# Model per role; empty = the provider's default (openai: gpt-4o-mini, ollama: qwen2.5:7b)
MODEL_CHAT=
MODEL_RESEARCHER=
MODEL_EMBED=
TOKEN_FLUSH_MS=20
SEARCH_FIXTURES_DIR=fixtures/search

# --- Models: prices, retries, circuit breaker (R14.1, R14.7) -----------------
# USD per million tokens, by model name (JSON). Unlisted models cost 0.
MODEL_PRICES='{"scripted": {"input_per_mtok": 0, "output_per_mtok": 0}}'
# One model call's time limit. A local model (Ollama, or on this machine or network) gets
# longer: its first call after a while loads it into memory, minutes on a busy laptop.
MODEL_TIMEOUT_S=60
LOCAL_MODEL_TIMEOUT_S=300
# One call to an MCP server's tool (Settings → Tools → MCP servers).
MCP_TIMEOUT_S=60
MODEL_RETRY_ATTEMPTS=3
MODEL_RETRY_BASE_S=1.0
MODEL_RETRY_CAP_S=20.0
BREAKER_FAILURES=5
BREAKER_WINDOW_S=30
BREAKER_OPEN_S=30

# --- Chat sessions & admission control (R12, R14.8, R15.6) -------------------
SESSION_MESSAGES_PER_MINUTE=10
# GLOBAL_DAILY_COST_USD=20     # unset: no daily ceiling
SESSION_IDLE_TTL_S=86400
SESSION_SWEEP_S=60

# --- Sub-agents per run (CR-005), configurable down only -----------------------
SUBAGENT_MAX_PARALLEL=4
SUBAGENT_MAX_TOTAL=10
SUBAGENT_TIMEOUT_S=180

# --- Agent definitions (R15.1), relative to backend/ ---------------------------
AGENTS_DIR=agents

# --- Leases & reclaim (R2.3, R2.4) -------------------------------------------
# HEARTBEAT_S must be <= LEASE_TTL_S / 3
LEASE_TTL_S=30
HEARTBEAT_S=10
REAPER_INTERVAL_S=5
MAX_RECLAIMS=3

# --- Observability (./setup.sh --observability, phases L4a, L7b) ---------------
# Set by setup: where the containers send their traces and log lines. Empty: no cost.
OTEL_ENDPOINT=
# The links Nuria shows, as a browser reaches them: Grafana (its traces and logs open in
# Explore: "Open the trace", "Its log lines"), and the dashboard.
TRACE_UI_URL=
DASHBOARD_URL=
GRAFANA_PORT=3001
PROMETHEUS_PORT=9090
# Grafana's admin (viewers need no login). Generated by ./setup.sh.
GRAFANA_ADMIN_PASSWORD=change-me-grafana
# Logs: containers write JSON lines (run_id, epoch, trace_id); a terminal gets text.
# LOG_FORMAT=json
